# Optional desktop panel (display only). Install the binary first:
#   install -Dm755 target/release/benchit-panel ~/.local/bin/benchit-panel
[Unit]
Description=benchit-telemetry desktop panel
PartOf=graphical-session.target
After=graphical-session.target benchit-telemetry.service

[Service]
Environment=BENCHIT_TELEMETRY_DIR=%h/.local/state/benchit-telemetry
ExecStart=%h/.local/bin/benchit-panel
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
