# systemd --user unit for the benchit-telemetry logger.
#   install -Dm755 target/release/benchit-telemetry ~/.local/bin/benchit-telemetry
#   install -Dm644 benchit-telemetry.service ~/.config/systemd/user/benchit-telemetry.service
#   systemctl --user daemon-reload && systemctl --user enable --now benchit-telemetry
#   loginctl enable-linger "$USER"   # optional: keep logging when nobody is logged in
[Unit]
Description=benchit-telemetry logger (30-day history, panel feed, HTTP API)

[Service]
# Data directory (metrics.db, latest.json, current.json): ~/.local/state/benchit-telemetry, created
# 0700 by systemd. To keep an older ~/telemetry layout instead, point both lines at it
# (and add it to ReadWritePaths).
StateDirectory=benchit-telemetry
StateDirectoryMode=0700
Environment=BENCHIT_TELEMETRY_DIR=%S/benchit-telemetry
ExecStart=%h/.local/bin/benchit-telemetry daemon --tick 2 --interval 10 --retain-days 30 --listen 127.0.0.1:9184
# If the collector thread dies the daemon exits, and systemd restarts it.
Restart=always
RestartSec=5
Nice=5
# Cheap hardening that works in user units. The daemon reads /proc and /sys and writes only to
# its state directory (ProtectSystem=strict keeps everything else read-only; add any
# --panel-json target directory to ReadWritePaths).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=default.target
